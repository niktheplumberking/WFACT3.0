{
  "_doc": "Claims gate rules (Step 4B M1). Versioned data, read by src/checks/claims.ts. bannedClaims distil memory/context.md R-10 (banned claims and content); each rule fails the page when its pattern matches visible text, aria-label, alt or title. factPatterns are the kinds of factual claim that must appear in the run's fact sources (the approved brief) or be visibly labelled SAMPLE. Patterns are JavaScript regular expressions, matched case-insensitively. Change a rule = bump version.",
  "version": "1.0.0",
  "sampleLabel": "\\bSAMPLE\\b",
  "bannedClaims": [
    { "id": "BC-LICENCE", "pattern": "\\blicen[cs]ed\\b|\\binsured\\b|\\bbonded\\b|\\blicen[cs]e\\s*(no\\.?|number|#)|\\bcertified\\b", "why": "Licence, insurance or certification statements need the client's documents and Nick's check (R-10)." },
    { "id": "BC-WARRANTY", "pattern": "\\bwarrant(y|ies)\\b|\\blifetime\\b|\\bguarantee(d|s)?\\b|\\b100%\\s+satisf", "why": "Warranty terms and guarantees need written client terms (R-10)." },
    { "id": "BC-SUPERLATIVE", "pattern": "\\bbest\\b|#\\s?1\\b|\\bnumber one\\b|\\bno\\.\\s?1\\b|\\bleading\\b|\\btop[- ]rated\\b|\\baward[- ]winning\\b|\\bworld[- ]class\\b", "why": "Superlatives need a cited source (R-10)." },
    { "id": "BC-YEARS", "pattern": "\\b(\\d+|one|two|three|four|five|ten|fifteen|twenty|thirty)\\+?\\s+years?\\s+(of\\s+)?(experience|in business|serving|in the trade)|\\bsince\\s+(19|20)\\d\\d\\b|\\best(\\.|ablished)\\s+(in\\s+)?(19|20)\\d\\d\\b", "why": "Years in business are never invented (R-10)." },
    { "id": "BC-COUNTS", "pattern": "\\b\\d[\\d,.]*\\s*k?\\+?\\s+(happy\\s+|satisfied\\s+)?(customers|clients|homeowners|homes|jobs|projects|roofs|reviews|families|businesses)\\b", "why": "Customer, job or review counts are never invented (R-10)." },
    { "id": "BC-RATING", "pattern": "★{2,}|⭐|\\b[1-5](\\.\\d)?\\s*(/\\s*5|out of 5|stars?)\\b|\\b5[- ]star\\b", "why": "Star ratings are never invented (R-10)." },
    { "id": "BC-AWARD", "pattern": "\\bawards?\\b|\\bawarded\\b", "why": "Awards are never invented (R-10)." },
    { "id": "BC-RESULTS", "pattern": "guarantee[sd]?\\s+(rankings?|traffic|leads|results|revenue)|\\bno\\s+[a-z]+(\\s+[a-z]+)?,?\\s+ever\\b", "why": "Guarantees of results and absolute promises are not made on the client's behalf (R-10)." },
    { "id": "BC-PLACEHOLDER", "pattern": "lorem ipsum|\\bTODO\\b|\\[insert|\\{\\{|\\bplaceholder text\\b", "why": "Lorem ipsum and unfilled placeholders never ship (R-10)." }
  ],
  "factPatterns": [
    { "id": "FACT-PHONE", "kind": "phone number", "pattern": "(\\+?1[\\s.-]?)?\\(?\\b\\d{3}\\)?[\\s.-]?\\d{3}[\\s.-]?\\d{4}\\b|\\b555[\\s.-]\\d{4}\\b" },
    { "id": "FACT-EMAIL", "kind": "email address", "pattern": "[a-z0-9._%+-]+@[a-z0-9.-]+\\.[a-z]{2,}" },
    { "id": "FACT-HOURS", "kind": "opening hours", "pattern": "\\b(mon|tue|tues|wed|thu|thur|thurs|fri|sat|sun)(day)?\\.?\\s*(–|—|-|to|through|thru)\\s*(mon|tue|tues|wed|thu|thur|thurs|fri|sat|sun)(day)?\\b|\\b\\d{1,2}(:\\d{2})?\\s*(am|pm)\\b|\\bopen\\s+24\\s*(/|hours)" },
    { "id": "FACT-PROMISE", "kind": "time promise", "pattern": "\\bwithin\\s+(\\d+|one|two|three|four|five|24|48|72)\\s+(business\\s+|working\\s+)?(minutes?|hours?|days?|weeks?)\\b|\\bsame[- ]day\\b|\\bnext[- ]day\\b|\\b24/7\\b" },
    { "id": "FACT-PRICE", "kind": "price", "pattern": "[$£€]\\s?\\d[\\d,]*(\\.\\d{2})?" },
    { "id": "FACT-PERCENT", "kind": "percentage", "pattern": "\\b\\d+(\\.\\d+)?\\s?%" },
    { "id": "FACT-ADDRESS", "kind": "street address", "pattern": "\\b\\d+\\s+[a-z]+(\\s+[a-z]+)?\\s+(street|st|road|rd|avenue|ave|lane|ln|drive|dr|boulevard|blvd|way|court|ct)\\b" }
  ],
  "serviceAreaLabel": "service areas?|areas? (we )?serve|neighbou?rhoods?( we serve)?|where we work|towns we cover",
  "fictionalContact": {
    "_doc": "Contact details that are fictional by definition (NANP 555-01xx numbers, RFC 2606 domains) must be visibly labelled SAMPLE where they appear.",
    "phone": "\\b555[\\s.-]?01\\d\\d\\b",
    "email": "@[a-z0-9.-]+\\.(example|test|invalid)\\b"
  }
}
