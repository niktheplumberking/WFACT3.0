{
  "name": "@wfact/planning",
  "version": "0.1.0",
  "private": true,
  "description": "Stage 4 Intake (fast tier) + Planner (mid tier) agents on the shared runtime; model choice comes from Hermes-lite's routing config, plans go to the Cockpit Approvals room.",
  "type": "module",
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
