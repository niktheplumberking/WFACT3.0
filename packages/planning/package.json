    "typecheck": "tsc --noEmit",
    "eval-direction": "tsx src/evalDirection.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@wfact/agent-runtime": "file:../agent-runtime",
    "@wfact/audit": "file:../audit",
    "@wfact/frontend-loop": "file:../frontend-loop",
    "@wfact/hermes-lite": "file:../hermes",
    "zod": "^4.6.5"
  }
}
