{
  "name": "@wfact/jobs",
  "version": "0.1.0",
  "private": true,
  "description": "Cockpit job runner: executes a jobs row (intake, replan, build_plan, resume, verify, ask) with the same pipeline code the CLIs use. Invoked by .github/workflows/cockpit-job.yml.",
  "type": "module",
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "run-job": "tsx src/run.ts",
    "attack:permissions": "tsx src/permissionsAttack.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@wfact/agent-runtime": "file:../agent-runtime",
    "@wfact/audit": "file:../audit",
    "@wfact/documentation": "file:../documentation",
    "@wfact/frontend-loop": "file:../frontend-loop",
    "@wfact/hermes-lite": "file:../hermes",
    "@wfact/planning": "file:../planning",
    "@wfact/rendered-qa": "file:../rendered-qa",
    "@wfact/verification": "file:../verification",
    "@wfact/workflow": "file:../workflow"
  }
}
