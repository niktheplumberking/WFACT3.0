{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "cockpit",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "apps/cockpit",
        "run",
        "dev",
        "--",
        "--host"
      ],
      "port": 5173
    },
    {
      "name": "track-b-out",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4321",
        "--bind",
        "127.0.0.1",
        "--directory",
        "packages/frontend-loop/starters/track-b/out"
      ],
      "port": 4321
    },
    {
      "name": "cockpit-fixtures",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "VITE_SUPABASE_URL=http://127.0.0.1:9",
        "VITE_SUPABASE_ANON_KEY=dev-fixture-not-a-key",
        "npm",
        "--prefix",
        "apps/cockpit",
        "run",
        "dev",
        "--",
        "--port",
        "5174",
        "--strictPort"
      ],
      "port": 5174
    },
    {
      "name": "cockpit-fake",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "COCKPIT_FAKE_DB=1",
        "VITE_SUPABASE_URL=http://127.0.0.1:9",
        "VITE_SUPABASE_ANON_KEY=dev-fixture-not-a-key",
        "npm",
        "--prefix",
        "apps/cockpit",
        "run",
        "dev",
        "--",
        "--port",
        "5175",
        "--strictPort"
      ],
      "port": 5175
    }
  ]
}
