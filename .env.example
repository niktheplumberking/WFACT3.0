# WFACT 3.0 — environment variable NAMES, never real values.
# Rewritten 2026-10-07 from what the code actually reads (see docs/HANDOFF.md section 8).
# Real values live in Doppler (project wfact-3-0-codebase, configs dev/prd), never in files.
# Run commands with `doppler run -- <cmd>`. The only GitHub Actions secret is DOPPLER_TOKEN.

# --- State layer (jobs runner, audit, documentation, hermes) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Models ---
ANTHROPIC_API_KEY=            # evaluator, planner, hermes
AGENT37_BASE_URL=             # builder + screenshot reviewer provider (Agent 37)
AGENT37_API_KEY=
# OPENAI_API_KEY=             # optional second-vendor reviewer/evaluator (no credits as of 2026-10-07)
# HF_CREDENTIALS=             # Higgsfield, Step 4B M5 images/video (no credits as of 2026-10-07)
# ANTHROPIC_MODEL=            # optional model override
# AGENT37_REQUEST_TIMEOUT_MS= # optional tuning
# AGENT37_RETRY_DELAYS_MS=    # optional tuning
# WFACT_ROUTE_<SLOT>=         # optional per-slot routing override
# WFACT_BUILDER_VENDOR=       # optional, used by rendered-qa / verification CLIs
# WFACT_BUILDER_MODEL=
# WFACT_TASK_ID=

# --- Deployment (CI only; hosting law: Hostinger live sites, Vercel previews and the Cockpit) ---
VERCEL_TOKEN=                 # held in Doppler prd, used by the deploy-cockpit CI job

# --- Supabase Edge Function secrets (dispatch-job): set in Supabase, NOT in Doppler ---
# GITHUB_DISPATCH_TOKEN=
# GITHUB_REPO=                # default niktheplumberking/WFACT3.0
# GITHUB_DISPATCH_REF=

# --- Cockpit (apps/cockpit/.env.example has the same two): public by design, set in Vercel ---
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=

# --- Not read by any code yet (planned): HOSTINGER_API_TOKEN, TELEGRAM_BOT_TOKEN (Step 17), STRIPE_SECRET_KEY,
#     MOTION_SITES_MCP_TOKEN, TWENTYFIRST_DEV_TOKEN / API_KEY_21ST. Add back when code reads them.
